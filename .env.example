# BondAI Environment Variables
# Copy to .env and populate production secrets before public deployment.

# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of this application (injected automatically in Cloud Run / AI Studio).
APP_URL="http://localhost:3000"

# NODE_ENV: "development" or "production"
NODE_ENV="development"

# MongoDB Atlas connection string (optional in local dev; falls back to persistent local SQLite if unset)
MONGODB_URI=

# Redis connection string for distributed rate limiting & Socket.IO adapter (optional in local dev)
REDIS_URL=

# 32-byte hex (64 chars) secrets for short-lived access & rotating refresh JWTs
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 32-byte hex (64 chars) master key for AES-256-GCM field-level encryption
FIELD_ENCRYPTION_MASTER_KEY=

# Optional comma-separated legacy keys for key rotation decryption (e.g. "v0:hexkey")
FIELD_ENCRYPTION_PREVIOUS_KEYS=

# 32-byte hex key for HMAC-SHA256 blind indexes (searchable encrypted fields)
BLIND_INDEX_HMAC_KEY=

# Google Cloud KMS resource name for envelope key wrapping in production
GOOGLE_CLOUD_KMS_KEY_NAME=

# Admin emergency passphrase override (leave blank in dev to use interactive one-time admin claim)
ADMIN_PASSCODE=

# Operational & Safety Controls
ENABLE_PUBLIC_REGISTRATION="true"
ENABLE_DEV_DEMO_ACCOUNTS="true"
DAILY_SWIPE_LIMIT="50"
AI_DAILY_QUOTA="40"
